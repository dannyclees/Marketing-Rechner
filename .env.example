# --- Pflicht in Produktion ---
# Zufälliger langer String (z. B. `openssl rand -hex 32`). Verschlüsselt die
# vollständigen Ergebnisse, bis die E-Mail eingegeben wurde.
REPORT_SECRET=

# --- Datenquellen (optional, aber empfohlen) ---
# SerpAPI: Google Ads Transparency (Region Luxemburg), Ranking auf google.lu,
# Google-Maps-Profil & Bewertungen. Ohne Key werden diese Checks geschätzt.
SERPAPI_KEY=
# Google PageSpeed Insights. Funktioniert auch ohne Key, aber mit Limit.
PAGESPEED_API_KEY=

# --- Leads speichern (optional) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Webhook für Zapier / Make / CRM. Bekommt jeden Lead als JSON.
LEAD_WEBHOOK_URL=

# --- E-Mail via Resend (optional) ---
RESEND_API_KEY=
MAIL_FROM="CE Marketing <report@deine-domain.lu>"
# Hierhin geht eine Benachrichtigung bei jedem neuen Lead
LEAD_NOTIFY_EMAIL=

# --- Frontend ---
NEXT_PUBLIC_BRAND_NAME="CE Marketing"
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/dein-link
